{
  "name": "dybs-skills",
  "version": "0.3.0",
  "description": "The Dybs method as agent skills. Install with `npx skills add Dybs-it/skills`; this CLI validates the context and updates skills without overwriting your edits.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dybs-it/skills.git"
  },
  "homepage": "https://github.com/Dybs-it/skills#readme",
  "bugs": {
    "url": "https://github.com/Dybs-it/skills/issues"
  },
  "type": "module",
  "bin": {
    "dybs-skills": "bin/dybs-skills.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node skills/dybs-start/scripts/dybs-validate.mjs",
    "record-hashes": "node scripts/record-hashes.mjs",
    "sync-rules": "node scripts/sync-rules.mjs"
  },
  "keywords": [
    "dybs",
    "agent-skills",
    "claude-code",
    "codex",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  }
}
